{
  "name": "magical-ascents",
  "scripts": {
    "build": "npx @tailwindcss/cli -i ./src/input.css -o ./public/src/output.css && cp ./src/main.js ./public/src/main.js && cp -r ./src/assets/* ./public/assets/ 2>/dev/null || true",
    "watch": "npx @tailwindcss/cli -i ./src/input.css -o ./public/src/output.css --watch"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "gsap": "^3.14.2",
    "tailwindcss": "^4.2.2"
  }
}
